<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    body { max-width: 760px; margin: 60px auto; padding: 20px; font-family: system-ui, sans-serif; }
    .demo-buttons { display: flex; flex-wrap: wrap; gap: 12px; }
    .demo-button { min-height: 44px; padding: 10px 15px; border: 1px solid #aeb7c4; border-radius: 6px; background: #fff; color: #17202a; cursor: pointer; }
  </style>
</head>
<body>
  <h1>Product tours demo</h1>
  <div class="demo-buttons">
    <% ProductTours::Seeds::BUTTONS.each do |key, label| %>
      <button class="demo-button" type="button" data-product-tour="<%= key %>"><%= label %></button>
    <% end %>
  </div>
  <%= product_tours_tag %>
</body>
</html>
